# Transport: "stdio" (default) or "http"
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=http)
PORT=3000

# Logging
LOG_LEVEL=info

# Server
NODE_ENV=development

# Daily Steam sync (node-cron, 04:00 local time).
# Mounted automatically when NODE_ENV=production; set to true to enable it in dev.
MCP_CRON_ENABLED=false

# Supabase (F1)
# Project URL: Supabase dashboard > Project Settings > API > Project URL
SUPABASE_URL=
# service_role key (legacy JWT) or sb_secret_... key:
# Supabase dashboard > Project Settings > API Keys. Bypasses RLS — never commit it.
SUPABASE_SERVICE_KEY=
# Your user id: any UUID you pick once (e.g. `node -e "console.log(crypto.randomUUID())"`)
# and keep. It scopes user_library, reviews and user_profile rows.
USER_ID=

# Steam (F1)
# Web API key (32 hex chars): https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# SteamID64 (17 digits): https://steamid.io — your game details must be public
# in Steam > Profile > Edit Profile > Privacy Settings, or GetOwnedGames returns nothing.
STEAM_ID=
