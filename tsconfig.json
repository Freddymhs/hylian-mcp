{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@config/*": ["src/config/*"],
      "@common/*": ["src/common/*"],
      "@tools/*": ["src/tools/*"],
      "@resources/*": ["src/resources/*"],
      "@prompts/*": ["src/prompts/*"],
      "@examples/*": ["src/examples/*"],
      "@db/*": ["src/db/*"],
      "@services/*": ["src/services/*"],
      "@jobs/*": ["src/jobs/*"],
      "@providers/*": ["src/providers/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
