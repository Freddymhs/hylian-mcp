{
  "name": "@fmarcosdev/hylian-mcp",
  "version": "0.1.0",
  "description": "MCP server personal para gestión de biblioteca gaming con sync Steam y recomendaciones",
  "author": "fmarcosdev",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "steam",
    "gaming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freddymhs/hylian-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Freddymhs/hylian-mcp/issues"
  },
  "homepage": "https://github.com/Freddymhs/hylian-mcp#readme",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "hylian-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/dist.mjs copy-sql",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "prepare": "husky",
    "clean": "node scripts/dist.mjs clean",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.118.0",
    "node-cron": "^4.6.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "undici": "^8.12.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.1.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
